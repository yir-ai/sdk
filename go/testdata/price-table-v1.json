        {
          "id": "video",
          "model": "demo/video",
          "operation": "generate_video",
          "conditions": {
            "duration": [
              5,
              10
            ],
            "audio": [
              false
            ]
          },
          "kind": "exact",
          "price": {
            "type": "unit",
            "amount": "100",
            "quantity": "duration",
            "per": "1",
            "rounding": "ceil"
          }
        }
      ]
    },
    "input": {
      "model": "demo/video",
