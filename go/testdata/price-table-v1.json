      "parameters": {
        "duration": 5,
        "audio": false
      }
    },
    "expected": {
      "kind": "exact",
      "amount": "500",
      "rowId": "video",
      "version": "retail-v1",
      "purpose": "retail",
      "unit": "credit",
      "scale": 100
    }
  },
